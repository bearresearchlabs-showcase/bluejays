{
  "name": "db",
  "version": "1.0.0",
  "private": true,
  "description": "Source → Ingest → Client: ingests source/ and converts to client/",
  "scripts": {
    "dev": "npm run dev --prefix apps/ingest",
    "dev:test": "npm run dev:test --prefix apps/ingest",
    "build": "npm run build --prefix apps/ingest",
    "build:web": "npm run build --prefix apps/web",
    "dev:web": "npm run dev --prefix apps/web",
    "start": "npm run start --prefix apps/ingest",
    "lint": "npm run lint --prefix apps/ingest",
    "test": "npm run test --prefix apps/ingest",
    "test:build": "npm run test:build --prefix apps/ingest",
    "test:quality": "npm run test:quality --prefix apps/ingest",
    "test:watch": "npm run test:watch --prefix apps/ingest",
    "test:integration": "npm run test:integration --prefix apps/ingest",
    "test:e2e": "npm run test:e2e --prefix apps/ingest",
    "test:e2e:ui": "npm run test:e2e:ui --prefix apps/ingest",
    "test:e2e:headed": "npm run test:e2e:headed --prefix apps/ingest",
    "test:all": "npm run test:all --prefix apps/ingest",
    "test:app": "bash scripts/test-app-running.sh",
    "kill:sessions": "bash scripts/kill-dev-sessions.sh",
    "queries:convert": "npm run queries:convert --prefix apps/ingest",
    "queries:md-to-json": "npm run queries:md-to-json --prefix apps/ingest",
    "queries:json-to-md": "npm run queries:json-to-md --prefix apps/ingest",
    "log:session": "node scripts/app-session-logger.js --from-git",
    "pre-commit:root": "bash scripts/pre-commit-root.sh"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}