# Copy to secret.yaml and fill in values. Do NOT commit secret.yaml.
# kubectl create secret generic db-validation-secret \
#   --from-literal=PG_PASSWORD=yourpassword \
#   -n db-validation
apiVersion: v1
kind: Secret
metadata:
  name: db-validation-secret
  namespace: db-validation
type: Opaque
stringData:
  PG_PASSWORD: "postgres"  # Change in production
