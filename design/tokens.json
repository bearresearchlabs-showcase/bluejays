{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "BLUEJAYS Design Tokens",
  "version": "1.0.0",
  "description": "Single source of truth for the BLUEJAYS benchmark brand. build_tokens.py compiles this file to tokens.css; components.css builds on the emitted custom properties. Palettes are drawn from the three existing artifact styles: the light academic landing (index.html), the dark engagement pages (mdp-tuple-architecture.html), and the OpenAI-docs deliverable style (mdp-architecture-db6.html).",
  "color": {
    "brand": {
      "jay":        { "light": "#1d4ed8", "dark": "#58a6ff" },
      "jay-strong": { "light": "#1e3a8a", "dark": "#79b8ff" },
      "jay-tint":   { "light": "#eff6ff", "dark": "#0f1b33" }
    },
    "surface": {
      "bg":      { "light": "#ffffff", "dark": "#0d1117" },
      "soft":    { "light": "#f8fafc", "dark": "#161b22" },
      "raised":  { "light": "#ffffff", "dark": "#1e2130" },
      "line":    { "light": "#e5e7eb", "dark": "#30363d" },
      "code-bg": { "light": "#0b1220", "dark": "#0b1220" },
      "code-fg": { "light": "#e6edf3", "dark": "#e6edf3" }
    },
    "text": {
      "ink":    { "light": "#111827", "dark": "#e6edf3" },
      "muted":  { "light": "#6b7280", "dark": "#8b949e" },
      "invert": { "light": "#ffffff", "dark": "#0d1117" }
    },
    "status": {
      "ok":     { "light": "#047857", "dark": "#3fb950" },
      "warn":   { "light": "#b45309", "dark": "#d29922" },
      "bad":    { "light": "#b91c1c", "dark": "#f85149" },
      "note":   { "light": "#6d28d9", "dark": "#bc8cff" },
      "ok-bg":   { "light": "#ecfdf5", "dark": "rgba(63,185,80,0.15)" },
      "warn-bg": { "light": "#fffbeb", "dark": "rgba(210,153,34,0.15)" },
      "bad-bg":  { "light": "#fef2f2", "dark": "rgba(248,81,73,0.15)" },
      "note-bg": { "light": "#f5f3ff", "dark": "rgba(188,140,255,0.15)" }
    }
  },
  "font": {
    "sans":  "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "serif": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Georgia, serif",
    "mono":  "'SF Mono', Menlo, Monaco, Consolas, monospace"
  },
  "text-scale": {
    "xs": "0.78rem", "sm": "0.875rem", "base": "1rem", "md": "1.1rem",
    "lg": "1.25rem", "xl": "1.5rem", "2xl": "2rem", "3xl": "3.2rem"
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "36px", "7": "64px" },
  "radius": { "sm": "4px", "md": "8px", "lg": "10px", "pill": "999px" },
  "line-height": { "tight": "1.3", "body": "1.65", "loose": "1.8" },
  "layout": { "measure": "960px", "sidebar": "280px" }
}
