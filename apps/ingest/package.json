{
  "name": "ingest",
  "description": "Ingests source/ and converts to client/",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3006",
    "dev:test": "node scripts/dev-test-wrapper.js",
    "build": "node ../../scripts/generate-sources-manifest.js --out=apps/ingest/lib/sources-manifest.json && next build --webpack",
    "start": "next start -p 3008",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "test:build": "TEST_BUILD=1 jest __tests__/quality/build-succeeds.test.ts --testTimeout=120000",
    "test:quality": "jest __tests__/quality --testTimeout=10000",
    "test:watch": "jest --watch",
    "test:integration": "BASE_URL=http://localhost:3007 jest __tests__/integration --testTimeout=10000",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test && npm run test:quality",
    "test:app": "bash ../../scripts/test-app-running.sh",
    "kill:sessions": "bash ../../scripts/kill-dev-sessions.sh",
    "queries:convert": "node ../../scripts/queries-convert/cli.js",
    "queries:md-to-json": "node ../../scripts/queries-convert/cli.js md-to-json",
    "queries:json-to-md": "node ../../scripts/queries-convert/cli.js json-to-md"
  },
  "dependencies": {
    "@types/pg": "^8.16.0",
    "@types/prismjs": "^1.26.6",
    "@vercel/analytics": "^1.1.0",
    "jose": "^5.2.0",
    "next": "16.1.7",
    "pg": "^8.18.0",
    "prismjs": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
