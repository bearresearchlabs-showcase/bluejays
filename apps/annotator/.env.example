# SQL Annotator — Vercel / Next.js env
# Copy to .env.local for local dev. Set in Vercel Dashboard for production.

# Auth (optional; defaults to dev secret)
JWT_SECRET=your-secret-for-production

# PostgreSQL (from Neon or Supabase integration)
# Vercel Marketplace: Integrations → Neon or Supabase
POSTGRES_URL=postgresql://user:pass@host/db?sslmode=require
# Or: DATABASE_URL=postgresql://...

# Vector DB (pgvector in PostgreSQL)
# Same POSTGRES_URL — enable: CREATE EXTENSION vector;
# For dedicated vector DB (optional): Pinecone, etc.
# VECTOR_DB_URL=
# PINECONE_API_KEY=
