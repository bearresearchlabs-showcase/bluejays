{
  "name": "db-documentation-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:test": "node scripts/dev-test-wrapper.js",
    "build": "bash scripts/prepare-for-vercel.sh && npm run sync-content && next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:components": "jest components/design-system",
    "test:visual": "jest __tests__/visual",
    "test:visual:styles": "node scripts/test-visual-styles.js",
    "test:changed": "jest --onlyChanged",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "pre-commit": "bash scripts/pre-commit.sh",
    "type-check": "tsc --noEmit",
    "extract-content": "node scripts/extract-deliverable-content.js",
    "build-website-db": "node scripts/build-website-database.js",
    "build-comprehensive-db": "node scripts/build-comprehensive-database.js",
    "sync-content": "npm run extract-content && npm run build-website-db && npm run build-comprehensive-db",
    "sync-to-qdrant": "node scripts/sync-to-qdrant.js",
    "watch-content": "node scripts/watch-and-sync.js",
    "verify-blob": "node scripts/verify-blob-config.js",
    "validate": "npm run type-check && npm run lint && npm test"
  },
  "dependencies": {
    "@db/db-utils": "*",
    "@vercel/analytics": "^1.1.0",
    "@vercel/blob": "^2.1.0",
    "next": "^16.2.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^16.1.6",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "marked": "^17.0.1",
    "typescript": "^5.0.0"
  }
}
