                    </div>
                    <div class="modal-body">
                        <legend>What's Next?</legend>
                        <ol>
                            <li>You will receive a summary confirmation email with your order ID.</li>
                            <li>When the request is ready, you will receive an email with download instructions.</li>
                        </ol>
                        <a id="modalCheckStatusLink" class="btn btn-primary btn-sm"
                           style="margin-top:10px;">Check Request Status</a>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" data-dismiss="modal">
                            Close
                        </button>
                        <a class="btn btn-default" href="https://gis.ngdc.noaa.gov/viewers/geophysics/">
                            <span class="glyphicon glyphicon-search"></span> New Search
                        </a>
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->

