                        <h4 class="modal-title">Survey Types : Icon Legend</h4>
                    </div>
                    <div class="modal-body">
                        <dl class="dl-horizontal">
                            <dt><span class="icon-geodas icon-B"></span></dt><dd><strong>B</strong>athymetry</dd>
                            <dt><span class="icon-geodas icon-M"></span></dt><dd><strong>M</strong>agnetics</dd>
                            <dt><span class="icon-geodas icon-G"></span></dt><dd><strong>G</strong>ravity</dd>
                            <dt><span class="icon-geodas icon-SC"></span></dt><dd><strong>S</strong>ingle <strong>C</strong>hannel Seismics</dd>
                            <dt><span class="icon-geodas icon-MC"></span></dt><dd><strong>M</strong>ulti-<strong>C</strong>hannel Seismics</dd>
                            <dt><span class="icon-geodas icon-SB"></span></dt><dd><strong>S</strong>ub<strong>b</strong>ottom Profile</dd>

                            <dt><span class="icon-geodas icon-SP"></span></dt><dd><strong>S</strong>hot-<strong>P</strong>oint Navigation</dd>
                            <dt><span class="icon-geodas icon-SR"></span></dt><dd><strong>S</strong>eismic <strong>R</strong>efraction</dd>
                            <dt><span class="icon-geodas icon-SS"></span></dt><dd><strong>S</strong>ide <strong>S</strong>can Sonar</dd>
