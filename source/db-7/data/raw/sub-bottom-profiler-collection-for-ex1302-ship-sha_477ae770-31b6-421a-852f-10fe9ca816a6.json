                                                       class="form-control formatInput"
                                                       placeholder="MGD77T" type="text" readonly="readonly"/>
                                            </div>

                                            <!-- MGD77T EXPANDABLE Z FIELD -->
                                            <div id="zfield" class="input-group input-group-sm">
                                                <div class="input-group-btn">
                                                    <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown">
                                                        Select Z Field
                                                        <span class="caret"></span>
                                                    </button>
