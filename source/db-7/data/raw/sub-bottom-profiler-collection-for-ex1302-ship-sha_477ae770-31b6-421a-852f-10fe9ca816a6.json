                                                        <li><a id="1" href="#">Bathymetric Corrected Depth (meters)</a></li>
                                                        <li><a id="2" href="#">Magnetic Total Field 1 (gammas)</a></li>
                                                        <li><a id="3" href="#">Magnetic Total Field 2 (gammas)</a></li>
                                                        <li><a id="4" href="#">Magnetic Residual Field (gammas)</a></li>
                                                        <li><a id="5" href="#">Magnetic Diurnal Correction (gammas)</a></li>
                                                        <li><a id="6" href="#">Gravity Observed (mgals)</a></li>
                                                        <li><a id="7" href="#">Gravity Eotvos Correction (mgals)</a></li>
                                                        <li><a id="8" href="#">Gravity Free Air (mgals)</a></li>
                                                        <li><a id="9" href="#">Uncorrected depth (meters)</a></li>
                                                    </ul>
