        <script type="text/javascript" src="//js.arcgis.com/3.7/"></script>
        <script type="text/javascript" src="js/geophysics_map.js"></script>
        <!-- Templates -->
        <script type="text/template" id="detailRowTemplate">
            <div class="row details-container">
            <div class="details-category">
            <ul>
            <li style="width:450px;"><span><%=cat%> : <%=subcat%></span> <span class="pull-right"><%=count%> file(s) / <%=$.bytesToMB(size)%></span></li>
            </ul>
            </div>
            </div>
        </script>
        <script type="text/template" id="ancillaryRow">
            <div class="row inline ancillarytext" id="<%=id%>">
            <div class="col-md-1" style="margin-right:0;padding-right:9px;">
            <input type="checkbox" <%=selected?'checked':''%>
            value="<%=category%>_<%=subCategory%>">
            </div>
            <div class="col-md-7" style="padding-left:7px;"><%=category%>: <%=subCategory%></div>
            <div class=""><%=numFiles%> / <%=$.bytesToMB(bytes)%></div>
            </div>
        </script>
        <script type="text/template" id="allSurveys">
            <div id="resultTable_allSurveys" class="allSurveys" style="width:100%;">
            <label style="float:left;">Select</label>
            <input type="checkbox" id="allSurveysCheckbox"
            aria-controls="resultTable" checked style="float:right;">
            </div>
        </script>

        <script defer>
            $(document).ready(function(){
                $('[data-toggle="tooltip"]').tooltip();
            });
        </script>
    <script id="_fed_an_ua_tag" type="text/javascript" src="/scripts/federated-analytics.js?agency=DOC&subagency=NOAA&pua=UA-44375312-1"></script></body>
</html>
