    <div class="hero container--flex">

        <div class="intro-mobile">
            <h1>Office for Coastal Management</h1>
            <p class="intro-text">
                Implements four major programs designed to help coastal and Great Lakes
                communities and ecosystems thrive.
            </p>
            <div id="programs-mobile">
            
                <div class="title-container">
                    <i class="left">-</i><h2>Programs</h2><i class="right">-</i> 
                </div>
                
                <div class="program-container">
                    <a onClick="ga('send', 'event', 'OCM: Home Hero', 'Click',  'Hero: CZM Button')" target="_blank" href="https://coast.noaa.gov/czm/" class="single-program">
                            <span>National Coastal Zone Management Program</span>
                    </a>
                    <a onClick="ga('send', 'event', 'OCM: Home Hero', 'Click',  'Hero: NERRS Button')" target="_blank" href="https://coast.noaa.gov/nerrs/" class="single-program">
                        <span>National Estuarine Research Reserve System</span>
                    </a>
                    <a onClick="ga('send', 'event', 'OCM: Home Hero', 'Click',  'Hero: Coral Reef Button')" target="_blank" href="https://coralreef.noaa.gov/" class="single-program">
                        <span>Coral Reef Conservation Program</span>
                    </a>
                    <a onClick="ga('send', 'event', 'OCM: Home Hero', 'Click',  'Hero: Digital Coast Button')" target="_blank" href="https://coast.noaa.gov/digitalcoast/" class="single-program">
                        <span>Digital Coast</span>
                    </a>
                </div>
            </div>
            <!-- %= link_to "About", "/about", :class => "button button-tiny white", :relative => true, :role => "link", :rel => "noopener" % -->
        </div>
    </div>

