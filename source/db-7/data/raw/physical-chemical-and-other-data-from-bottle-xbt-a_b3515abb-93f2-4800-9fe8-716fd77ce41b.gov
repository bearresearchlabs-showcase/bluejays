$(document).ready(function() {
// remove external link fa icons
$('.fa-external-link').remove();


function bindNavbar() {
    if ($(window).width() > 767) {
        $('.navbar-default .dropdown').on('mouseover', function(){
            $('.dropdown-toggle', this).next('.dropdown-menu').show();
            }).on('mouseout', function(){
                $('.dropdown-toggle', this).next('.dropdown-menu').hide();
            });
    } else {
    $('.navbar-default .dropdown').off('mouseover').off('mouseout');
    }
} // close bindNavBar fn
bindNavbar();

// watch for "open" and make sure the menu is open if it has that class
const menuOpenCallback = mutations => {
    mutations.forEach(mutation => {
        if(mutation.type === "attributes" && mutation.attributeName === "class"){
        let currentlyOpen = mutation.target.classList.contains("open");
        if(currentlyOpen){
            $('.open > .dropdown-toggle', this).next('.dropdown-menu').show();
            console.log("Issued show command");
        } else {
            $('.dropdown-toggle', this).next('.dropdown-menu').hide();
            console.log("Issued hide command");
        }
        }
    })
} // close menuOpenCallback definition

const classObserver = new MutationObserver(menuOpenCallback)
function bindClassObserver() {
    classObserver.observe(document.getElementById("collapsemenu"),
        {subtree: true, attributes: true, attributeFilter: ["class"]}
        );
    // console.log("classObserver ON");
    /* 
    // -- if toggling based on viewport, then instead: 
    if ($(window).width() > 767){
        classObserver.observe(document.getElementById("collapsemenu"),
        {subtree: true, attributes: true, attributeFilter: ["class"]}
        );
        console.log("classObserver ON");
    } else {
        classObserver.disconnect();
        console.log("classObserver OFF");
    }*/
}
bindClassObserver();

$(window).resize(function() {
    bindNavbar();
    //bindClassObserver();
});

// hide LibGuides share button in a-z database 
$("div.s-lg-az-result > div.s-lg-az-result-share").hide();


}); // close of document ready
