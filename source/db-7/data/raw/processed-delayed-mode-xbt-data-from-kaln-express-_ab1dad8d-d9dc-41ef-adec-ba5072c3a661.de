;(function responsive(){
  if (window.matchMedia) {
    var m = window.matchMedia( "(max-width: 1200px)" );
    var s = window.matchMedia( "(max-width: 640px)" );
    m.addListener(function() {responsive(m,s)});
    s.addListener(function() {responsive(m,s)});
    responsive(m,s)
  }
  function responsive(m,s){
    var cl = 'l';
