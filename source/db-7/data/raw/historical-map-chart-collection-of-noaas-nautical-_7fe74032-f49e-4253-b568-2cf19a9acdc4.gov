<script>
	
	function adjustSize(){
		var about = document.getElementById("aboutText");
		var search = document.getElementById("searchText");
		var pub = document.getElementById("pubText");
		var fc = document.getElementById("fcText");
		var links = document.getElementById("linksText");
		
		var broWidth = document.body.clientWidth;

		if (broWidth > 767){
			about.style.marginRight = broWidth/30;
			about.style.marginLeft = broWidth/30;
			search.style.marginRight = broWidth/30;
			search.style.marginLeft = broWidth/30;
			pub.style.marginRight = broWidth/30;
			pub.style.marginLeft = broWidth/30;
			fc.style.marginRight = broWidth/30;
			fc.style.marginLeft = broWidth/30;
			links.style.marginRight = broWidth/30;
			links.style.marginLeft = broWidth/30;
		}
	}
	
	function displayLinks(){
		var about = document.getElementById("about");
		var search = document.getElementById("search");
		var pub = document.getElementById("pub");
		var fc = document.getElementById("fc");
		var links = document.getElementById("links");
		
		var aboutText = document.getElementById("aboutText");
		var searchText = document.getElementById("searchText");
		
		var nav = document.getElementById("nav");
		if (about.style.display == "inline-block"){
			about.style.cssText = "null";
			search.style.cssText = "null";
			pub.style.cssText = "null";
			fc.style.cssText = "null";
			links.style.cssText = "null";
		}
		else{
			about.style.display = "inline-block";
			search.style.display = "block";
			pub.style.display = "block";
			fc.style.display = "block";
			links.style.display = "block";
		}
	}

	
	window.addEventListener("resize", adjustSize);
	window.onload = adjustSize();
</script>		
