    <script id="site-injection">
      window.__SITE="%7B%22site%22%3A%7B%22item%22%3A%7B%22id%22%3A%22c6d994ef5090419fa6e277bf934751bf%22%2C%22owner%22%3A%22avery.paxton_noaa%22%2C%22orgId%22%3A%22C8EMgrsFcRFL6LrL%22%2C%22created%22%3A1589900053000%2C%22modified%22%3A1623762595000%2C%22guid%22%3Anull%2C%22name%22%3Anull%2C%22title%22%3A%22Living%20Shipwrecks%203D%22%2C%22type%22%3A%22Hub%20Site%20Application%22%2C%22typeKeywords%22%3A%5B%22Hub%22%2C%22hubSite%22%2C%22hubSolution%22%2C%22JavaScript%22%2C%22Map%22%2C%22Mapping%20Site%22%2C%22Online%20Map%22%2C%22OpenData%22%2C%22Ready%20To%20Use%22%2C%22selfConfigured%22%2C%22state%3AhasUnpublishedChanges%22%2C%22Web%20Map%22%2C%22Registered%20App%22%5D%2C%22description%22%3A%22This%20project%20provides%20three-dimensional%20(3D)%20visualizations%20of%20fish%20around%20shipwrecks%20located%20on%20the%20continental%20shelf%20of%20North%20Carolina%2C%20USA.%20The%20data%20layers%20within%20this%20project%20include%20multibeam%20bathymetry%20of%20the%20shipwrecks%2C%20as%20well%20as%203D%20representations%20of%20individual%20fish%20and%20schools%20of%20fish.%20Fish%20were%20detected%20with%20two%20types%20of%20echosounders%3A%201)%20splitbeam%20echosounder%20and%202)%20multibeam%20echosounder.%20The%20splitbeam%20echosounder%20ensonified%20fish%20within%20a%20narrow%20(7-degree)%20beam%20width%20and%20allowed%20quantification%20of%20individual%20fish%2C%20as%20well%20as%20fish%20schools.%20The%20multibeam%20echosounder%20ensonified%20fish%20within%20a%20broader%20beam%20width%2C%20permitting%20visualizations%20of%20the%20broader%20extent%20of%20fish%20schools.%22%2C%22tags%22%3A%5B%22shipwreck%22%2C%22fish%22%2C%22North%20Carolina%22%2C%22echosounder%22%2C%22splitbeam%22%2C%22multibeam%22%2C%22remote%20sensing%22%2C%22marine%22%5D%2C%22snippet%22%3A%22This%20is%20the%20main%20Hub%20Site%20for%20the%20%5C%22Living%20Shipwrecks%203D%5C%22%20project.%20%22%2C%22thumbnail%22%3A%22thumbnail%2Fthumbnail1590496114231.png%22%2C%22documentation%22%3Anull%2C%22e