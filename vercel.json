{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash scripts/prepare_vercel_public.sh",
  "outputDirectory": "public",
  "rewrites": [
    {"source": "/", "destination": "/index.html"},
    {"source": "/db-1", "destination": "/db-1/db-1_documentation.html"},
    {"source": "/db-1_deliverable.json", "destination": "/db-1/db-1_deliverable.json"},
    {"source": "/db-2", "destination": "/db-2/db-2_documentation.html"},
    {"source": "/db-2_deliverable.json", "destination": "/db-2/db-2_deliverable.json"},
    {"source": "/db-3", "destination": "/db-3/db-3_documentation.html"},
    {"source": "/db-3_deliverable.json", "destination": "/db-3/db-3_deliverable.json"},
    {"source": "/db-4", "destination": "/db-4/db-4_documentation.html"},
    {"source": "/db-4_deliverable.json", "destination": "/db-4/db-4_deliverable.json"},
    {"source": "/db-5", "destination": "/db-5/db-5_documentation.html"},
    {"source": "/db-5_deliverable.json", "destination": "/db-5/db-5_deliverable.json"},
    {"source": "/db-6", "destination": "/db-6/db-6_documentation.html"},
    {"source": "/db-6_deliverable.json", "destination": "/db-6/db-6_deliverable.json"},
    {"source": "/db-7", "destination": "/db-7/db-7_documentation.html"},
    {"source": "/db-7_deliverable.json", "destination": "/db-7/db-7_deliverable.json"},
    {"source": "/db-8", "destination": "/db-8/db-8_documentation.html"},
    {"source": "/db-8_deliverable.json", "destination": "/db-8/db-8_deliverable.json"},
    {"source": "/db-9", "destination": "/db-9/db-9_documentation.html"},
    {"source": "/db-9_deliverable.json", "destination": "/db-9/db-9_deliverable.json"},
    {"source": "/db-10", "destination": "/db-10/db-10_documentation.html"},
    {"source": "/db-10_deliverable.json", "destination": "/db-10/db-10_deliverable.json"},
    {"source": "/db-11", "destination": "/db-11/db-11_documentation.html"},
    {"source": "/db-11_deliverable.json", "destination": "/db-11/db-11_deliverable.json"},
    {"source": "/db-16", "destination": "/db-16/db-16_documentation.html"},
    {"source": "/db-16_deliverable.json", "destination": "/db-16/db-16_deliverable.json"}
  ],
  "headers": [
    {"source": "/(.*\\.html)", "headers": [{"key": "Content-Type", "value": "text/html"}]},
    {"source": "/(.*\\.json)", "headers": [{"key": "Content-Type", "value": "application/json"}]}
  ]
}
