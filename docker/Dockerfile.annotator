# Annotator webapp — serves SQL annotation UI, reads/writes source/ and template/
# Pipeline: queries.md → queries.json (extract) → Qdrant (ingest) → webapp
# Usage: part of docker-compose.work-microservices.yml

FROM python:3.11-slim

WORKDIR /app

RUN adduser --disabled-password --gecos "" appuser

# Copy scripts (annotator_app, extract_queries_to_json, etc.)
COPY scripts/ ./scripts/
COPY docker/entrypoint-annotator.sh /entrypoint.sh

# Install psycopg2 for Validate SQL / Run query against live DB (same session as deploy)
RUN pip install --no-cache-dir psycopg2-binary>=2.9.0

# source/ and template/ are mounted at runtime
RUN mkdir -p source template && chown -R appuser:appuser /app && chmod +x /entrypoint.sh

USER appuser

EXPOSE 8766

ENV PYTHONUNBUFFERED=1
# Entrypoint: extract queries.md→json, sync to Qdrant, then serve webapp
ENTRYPOINT ["/entrypoint.sh"]
