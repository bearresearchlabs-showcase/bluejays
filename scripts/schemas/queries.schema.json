{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/queries.schema.json",
  "title": "queries.json",
  "description": "JSON Schema for db-N queries.json (BIRD benchmark query metadata)",
  "type": "object",
  "required": ["queries", "total_queries"],
  "properties": {
    "source_file": {
      "type": "string",
      "description": "Path to source queries.md file"
    },
    "extraction_timestamp": {
      "type": "string",
      "pattern": "^\\d{8}-\\d{4}$",
      "description": "Extraction timestamp in YYYYMMDD-HHMM format (EST)"
    },
    "total_queries": {
      "type": "integer",
      "minimum": 30,
      "maximum": 30,
      "description": "Must be exactly 30 queries per database"
    },
    "queries": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/query"
      }
    }
  },
  "$defs": {
    "query": {
      "type": "object",
      "required": ["number", "title", "question", "description", "evidence", "complexity", "expected_output", "sql", "line_number"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Contextual story: who has this need, what problem, why it matters. Not technical/SQL."
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "description": "Technical: what the query does, SQL operations, CTEs, etc."
        },
        "complexity": {
          "type": "string",
          "minLength": 1
        },
        "expected_output": {
          "type": "string",
          "minLength": 1
        },
        "sql": {
          "type": "string",
          "minLength": 1
        },
        "line_number": {
          "type": "integer",
          "minimum": 1
        },
        "normal_query": {
          "type": "string",
          "description": "Natural language summary of the query"
        }
      }
    }
  }
}
