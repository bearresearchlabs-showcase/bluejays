# Copy to .env and fill in values. Do NOT commit .env.
# Loaded by jenkins_run.sh, run_all_tests.sh, gdpval_langgraph_harness, qa_claude, etc.

# Anthropic API (for Claude QA - qa_claude.py)
ANTHROPIC_API_KEY=your_key_here

# --- client/.env (or set here) ---
# PostgreSQL - CI/CD, SLURM, Jenkins set these. No particular port required.
# Single DB: PG_HOST, PG_PORT, PG_USER, PG_PASSWORD, PG_DATABASE
PG_HOST=localhost
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=postgres

# Multi-DB (Docker Compose): DB_PORTS_START → db-1=5436, db-2=5437, ...
# Or per-db: PG_PORT_DB1=5436, PG_PORT_DB2=5437, ...
DB_PORTS_START=5436
DB_PORTS_END=5451

# Docker Hub (for /QA --push: upload hardened PostgreSQL images)
# DOCKER_HUB_USER=your_dockerhub_username
# docker login  # or DOCKER_HUB_TOKEN for CI

# Kubernetes (optional)
KUBE_NAMESPACE=db-validation
KUBE_PARALLEL_JOBS=4
